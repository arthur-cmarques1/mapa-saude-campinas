# OPCIONAL. Copie para .env e preencha só se for ler do MongoDB Atlas.
# Sem esta variável, src/loader.py lê os arquivos locais em data/*.json.
# O Python não carrega .env sozinho: exporte a variável no terminal
# (ex.: export MONGO_URI="...") antes de rodar.
# Formato: mongodb+srv://USUARIO:SENHA@SEU_CLUSTER.mongodb.net/
# NUNCA faça commit de um .env com valor real.
MONGO_URI=
